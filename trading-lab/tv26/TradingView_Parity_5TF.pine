//@version=6
import TradingView/TechnicalRating/3 as tvRating

indicator("TV26 — مرجع مطابقة الملخصات (5 أطر)", overlay=false, precision=3)

// Return the prior confirmed bar in the requested timeframe.
// lookahead_on is safe here because every returned expression is offset by [1].
f_ratings_confirmed() =>
    [totalRating, oscillatorRating, maRating] = tvRating.calcRatingAll()
    [totalRating[1], maRating[1], oscillatorRating[1]]

f_label(float rating) =>
    na(rating) ? "غير متاح" :
     rating > 0.5 ? "شراء قوي" :
     rating > 0.1 ? "شراء" :
     rating < -0.5 ? "بيع قوي" :
     rating < -0.1 ? "بيع" : "حياد"

f_text(float rating) =>
    na(rating) ? "—" : str.tostring(rating, "#.000")

f_time(int stamp) =>
    na(stamp) ? "—" : str.format_time(stamp, "yyyy-MM-dd HH:mm", syminfo.timezone)

tf1 = input.timeframe("1", "الإطار 1")
tf2 = input.timeframe("5", "الإطار 2")
tf3 = input.timeframe("15", "الإطار 3")
tf4 = input.timeframe("30", "الإطار 4")
tf5 = input.timeframe("60", "الإطار 5")

[total1, ma1, osc1] = request.security(syminfo.tickerid, tf1, f_ratings_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[total2, ma2, osc2] = request.security(syminfo.tickerid, tf2, f_ratings_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[total3, ma3, osc3] = request.security(syminfo.tickerid, tf3, f_ratings_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[total4, ma4, osc4] = request.security(syminfo.tickerid, tf4, f_ratings_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[total5, ma5, osc5] = request.security(syminfo.tickerid, tf5, f_ratings_confirmed(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// The timestamps refer to the same prior, confirmed candle values as the ratings.
ts1 = request.security(syminfo.tickerid, tf1, time[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ts2 = request.security(syminfo.tickerid, tf2, time[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ts3 = request.security(syminfo.tickerid, tf3, time[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ts4 = request.security(syminfo.tickerid, tf4, time[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
ts5 = request.security(syminfo.tickerid, tf5, time[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

var table t = table.new(position.top_right, 8, 6, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "الإطار", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 1, 0, "الشمعة المغلقة", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 2, 0, "الملخص العام", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 3, 0, "درجة العام", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 4, 0, "المتوسطات", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 5, 0, "درجة المتوسطات", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 6, 0, "المذبذبات", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 7, 0, "درجة المذبذبات", text_color=color.white, bgcolor=color.rgb(45, 55, 72))
    table.cell(t, 0, 1, tf1)
    table.cell(t, 1, 1, f_time(ts1))
    table.cell(t, 2, 1, f_label(total1))
    table.cell(t, 3, 1, f_text(total1))
    table.cell(t, 4, 1, f_label(ma1))
    table.cell(t, 5, 1, f_text(ma1))
    table.cell(t, 6, 1, f_label(osc1))
    table.cell(t, 7, 1, f_text(osc1))
    table.cell(t, 0, 2, tf2)
    table.cell(t, 1, 2, f_time(ts2))
    table.cell(t, 2, 2, f_label(total2))
    table.cell(t, 3, 2, f_text(total2))
    table.cell(t, 4, 2, f_label(ma2))
    table.cell(t, 5, 2, f_text(ma2))
    table.cell(t, 6, 2, f_label(osc2))
    table.cell(t, 7, 2, f_text(osc2))
    table.cell(t, 0, 3, tf3)
    table.cell(t, 1, 3, f_time(ts3))
    table.cell(t, 2, 3, f_label(total3))
    table.cell(t, 3, 3, f_text(total3))
    table.cell(t, 4, 3, f_label(ma3))
    table.cell(t, 5, 3, f_text(ma3))
    table.cell(t, 6, 3, f_label(osc3))
    table.cell(t, 7, 3, f_text(osc3))
    table.cell(t, 0, 4, tf4)
    table.cell(t, 1, 4, f_time(ts4))
    table.cell(t, 2, 4, f_label(total4))
    table.cell(t, 3, 4, f_text(total4))
    table.cell(t, 4, 4, f_label(ma4))
    table.cell(t, 5, 4, f_text(ma4))
    table.cell(t, 6, 4, f_label(osc4))
    table.cell(t, 7, 4, f_text(osc4))
    table.cell(t, 0, 5, tf5)
    table.cell(t, 1, 5, f_time(ts5))
    table.cell(t, 2, 5, f_label(total5))
    table.cell(t, 3, 5, f_text(total5))
    table.cell(t, 4, 5, f_label(ma5))
    table.cell(t, 5, 5, f_text(ma5))
    table.cell(t, 6, 5, f_label(osc5))
    table.cell(t, 7, 5, f_text(osc5))

plot(total1, "الملخص العام — الإطار 1", color=color.new(color.blue, 0))
hline(0.5, "حد الشراء القوي", color=color.new(color.green, 30))
hline(0.1, "حد الشراء", color=color.new(color.green, 65))
hline(-0.1, "حد البيع", color=color.new(color.red, 65))
hline(-0.5, "حد البيع القوي", color=color.new(color.red, 30))
