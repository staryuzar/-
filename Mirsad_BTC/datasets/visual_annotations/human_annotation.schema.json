{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirsad Engine 2 Human Visual Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_version",
    "sample_fingerprint",
    "symbol",
    "timeframe",
    "data_split",
    "label_source",
    "manual_reviewed",
    "patterns"
  ],
  "properties": {
    "annotation_version": {
      "const": "1.0.0"
    },
    "sample_fingerprint": {
      "type": "string",
      "minLength": 16
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d",
        "1w"
      ]
    },
    "market_regime": {
      "type": "string"
    },
    "data_split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "holdout"
      ]
    },
    "label_source": {
      "type": "string",
      "enum": [
        "HUMAN",
        "HUMAN_REVIEWED",
        "EXPERT_REVIEWED",
        "TA-LIB",
        "SYNTHETIC",
        "OTHER"
      ]
    },
    "manual_reviewed": {
      "type": "boolean"
    },
    "review_guidelines_version": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "start_index",
          "end_index",
          "direction"
        ],
        "properties": {
          "pattern_id": {
            "type": "string"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "type": "string",
            "enum": [
              "BULLISH",
              "BEARISH",
              "NEUTRAL",
              "CONTEXTUAL"
            ]
          },
          "context_note": {
            "type": "string"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "AMBIGUOUS",
              "REJECTED"
            ]
          }
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "structure_id",
          "start_index",
          "end_index",
          "confirmed"
        ],
        "properties": {
          "structure_id": {
            "type": "string"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "confirmed": {
            "type": "boolean"
          },
          "level_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "zone_low": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "zone_high": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "context_note": {
            "type": "string"
          }
        }
      }
    },
    "image_source_url": {
      "type": "string",
      "format": "uri",
      "description": "Public or internal source of the reviewed image; retain provenance."
    },
    "snapshot_time_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Chart snapshot time in UTC, when known."
    },
    "price_scale_type": {
      "type": "string",
      "enum": [
        "linear",
        "logarithmic"
      ]
    },
    "visual_bias_scope": {
      "type": "string",
      "enum": [
        "VISIBLE_CHART_WINDOW"
      ],
      "description": "This label describes the visible chart window only, not multi-timeframe confluence."
    },
    "visual_bias": {
      "type": "string",
      "enum": [
        "BULLISH",
        "BEARISH",
        "NEUTRAL",
        "CONTEXTUAL",
        "UNKNOWN"
      ]
    },
    "last_candle_direction": {
      "type": "string",
      "enum": [
        "BULLISH",
        "BEARISH",
        "DOJI",
        "UNKNOWN"
      ]
    },
    "last_candle_ohlc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open",
        "high",
        "low",
        "close"
      ],
      "properties": {
        "open": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "low": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "close": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Reference OHLC for the final visible candle; use only when verified from the same chart and timestamp."
    },
    "trend_windows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short_6": {
          "type": "string",
          "enum": [
            "BULLISH",
            "BEARISH",
            "NEUTRAL",
            "MIXED_OR_UNKNOWN",
            "UNKNOWN"
          ]
        },
        "medium_12": {
          "type": "string",
          "enum": [
            "BULLISH",
            "BEARISH",
            "NEUTRAL",
            "MIXED_OR_UNKNOWN",
            "UNKNOWN"
          ]
        },
        "long_30": {
          "type": "string",
          "enum": [
            "BULLISH",
            "BEARISH",
            "NEUTRAL",
            "MIXED_OR_UNKNOWN",
            "UNKNOWN"
          ]
        }
      },
      "description": "Human-reviewed directional labels for six-, twelve-, and thirty-candle windows within the same chart timeframe."
    },
    "market_structure_direction": {
      "type": "string",
      "enum": [
        "BULLISH",
        "BEARISH",
        "MIXED_OR_UNKNOWN",
        "UNKNOWN"
      ]
    },
    "momentum_direction": {
      "type": "string",
      "enum": [
        "BULLISH",
        "BEARISH",
        "NEUTRAL",
        "UNKNOWN"
      ]
    }
  },
  "description": "Human labels must be reviewed from source chart/OHLC without future-return labels. Machine-generated labels must never be declared manually reviewed."
}
