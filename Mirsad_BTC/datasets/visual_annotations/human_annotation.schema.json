{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirsad Engine 2 Human Visual Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotation_version",
    "sample_fingerprint",
    "symbol",
    "timeframe",
    "data_split",
    "label_source",
    "manual_reviewed",
    "patterns"
  ],
  "properties": {
    "annotation_version": {
      "const": "1.0.0"
    },
    "sample_fingerprint": {
      "type": "string",
      "minLength": 16
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d",
        "1w"
      ]
    },
    "market_regime": {
      "type": "string"
    },
    "data_split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "holdout"
      ]
    },
    "label_source": {
      "type": "string",
      "enum": [
        "HUMAN",
        "HUMAN_REVIEWED",
        "EXPERT_REVIEWED",
        "TA-LIB",
        "SYNTHETIC",
        "OTHER"
      ]
    },
    "manual_reviewed": {
      "type": "boolean"
    },
    "review_guidelines_version": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "start_index",
          "end_index",
          "direction"
        ],
        "properties": {
          "pattern_id": {
            "type": "string"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "direction": {
            "type": "string",
            "enum": [
              "BULLISH",
              "BEARISH",
              "NEUTRAL",
              "CONTEXTUAL"
            ]
          },
          "context_note": {
            "type": "string"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "AMBIGUOUS",
              "REJECTED"
            ]
          }
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "structure_id",
          "start_index",
          "end_index",
          "confirmed"
        ],
        "properties": {
          "structure_id": {
            "type": "string"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0
          },
          "end_index": {
            "type": "integer",
            "minimum": 0
          },
          "confirmed": {
            "type": "boolean"
          },
          "level_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "zone_low": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "zone_high": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "context_note": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Human labels must be reviewed from source chart/OHLC without future-return labels. Machine-generated labels must never be declared manually reviewed."
}